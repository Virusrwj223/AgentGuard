# Optional. Existing PowerShell environment settings take precedence.
# Copy to .env beside run.py when moving an existing calibrated installation.
# Windows paths can use forward slashes.
# AG_PAT_EXE=C:/codingProjects/patato/pat_lib/PAT3.Console.exe
# AG_PAT_VERSION=your_verified_file_version
# AG_PAT_SHA256=your_verified_sha256
# AG_DB=instance/agentguard.sqlite3

# Optional hosted Qwen. With a matching Singapore Model Studio key, the site
# can use a Qwen model with QwenWork Desktop fully closed. Both fields are required.
# AG_QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
# AG_QWEN_MODEL=qwen-plus

# Internet place search, optional flight estimates and simulated demo prices.
AG_TRAVEL_MODE=web
# Optional Google Flights estimates (250 searches/month on the SerpApi free plan).
# SERPAPI_API_KEY=

# Legacy Amadeus adapter settings. The public Self-Service portal closed in 2026.
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
