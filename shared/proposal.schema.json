{
  "$defs": {
    "Conditional": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "IF",
          "title": "Op",
          "type": "string"
        },
        "predicate": {
          "const": "AMENDMENT_APPROVED",
          "title": "Predicate",
          "type": "string"
        },
        "then": {
          "discriminator": {
            "mapping": {
              "ADJUST_PRICE": "#/$defs/Price",
              "CONFIRM_AMENDMENT": "#/$defs/Confirm",
              "GUARANTEE_AMENDMENT": "#/$defs/Request",
              "IF": "#/$defs/Conditional",
              "ISSUE_TRIP_CREDIT": "#/$defs/Credit",
              "KEEP_BOOKING": "#/$defs/Keep",
              "REQUEST_AMENDMENT": "#/$defs/Request",
              "REVISE_ITINERARY": "#/$defs/ReviseItinerary",
              "SEQUENCE": "#/$defs/Sequence",
              "UPDATE_ITINERARY_DETAILS": "#/$defs/ReviseItinerary",
              "UPDATE_SEAT_PREFERENCE": "#/$defs/UpdateSeatPreference",
              "UPGRADE": "#/$defs/Upgrade"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Keep"
            },
            {
              "$ref": "#/$defs/Request"
            },
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "$ref": "#/$defs/Price"
            },
            {
              "$ref": "#/$defs/Credit"
            },
            {
              "$ref": "#/$defs/Upgrade"
            },
            {
              "$ref": "#/$defs/UpdateSeatPreference"
            },
            {
              "$ref": "#/$defs/ReviseItinerary"
            },
            {
              "$ref": "#/$defs/Sequence"
            },
            {
              "$ref": "#/$defs/Conditional"
            }
          ],
          "title": "Then"
        },
        "otherwise": {
          "discriminator": {
            "mapping": {
              "ADJUST_PRICE": "#/$defs/Price",
              "CONFIRM_AMENDMENT": "#/$defs/Confirm",
              "GUARANTEE_AMENDMENT": "#/$defs/Request",
              "IF": "#/$defs/Conditional",
              "ISSUE_TRIP_CREDIT": "#/$defs/Credit",
              "KEEP_BOOKING": "#/$defs/Keep",
              "REQUEST_AMENDMENT": "#/$defs/Request",
              "REVISE_ITINERARY": "#/$defs/ReviseItinerary",
              "SEQUENCE": "#/$defs/Sequence",
              "UPDATE_ITINERARY_DETAILS": "#/$defs/ReviseItinerary",
              "UPDATE_SEAT_PREFERENCE": "#/$defs/UpdateSeatPreference",
              "UPGRADE": "#/$defs/Upgrade"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Keep"
            },
            {
              "$ref": "#/$defs/Request"
            },
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "$ref": "#/$defs/Price"
            },
            {
              "$ref": "#/$defs/Credit"
            },
            {
              "$ref": "#/$defs/Upgrade"
            },
            {
              "$ref": "#/$defs/UpdateSeatPreference"
            },
            {
              "$ref": "#/$defs/ReviseItinerary"
            },
            {
              "$ref": "#/$defs/Sequence"
            },
            {
              "$ref": "#/$defs/Conditional"
            }
          ],
          "title": "Otherwise"
        }
      },
      "required": [
        "op",
        "predicate",
        "then",
        "otherwise"
      ],
      "title": "Conditional",
      "type": "object"
    },
    "Confirm": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "CONFIRM_AMENDMENT",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Confirm",
      "type": "object"
    },
    "Credit": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ISSUE_TRIP_CREDIT",
          "title": "Op",
          "type": "string"
        },
        "credit_cents": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Credit Cents",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "credit_cents"
      ],
      "title": "Credit",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "amend",
            "sale",
            "credit",
            "upgrade",
            "amend_upgrade",
            "seat_preference",
            "itinerary",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItineraryFields"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_charge_limit_cents": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Charge Limit Cents"
        },
        "days": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        },
        "discount_cents": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discount Cents"
        },
        "max_extra_charge_cents": {
          "default": 0,
          "maximum": 100000000,
          "minimum": 0,
          "title": "Max Extra Charge Cents",
          "type": "integer"
        },
        "seat_preference": {
          "anyOf": [
            {
              "enum": [
                "WINDOW",
                "AISLE",
                "MIDDLE",
                "TOGETHER",
                "ANY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Preference"
        }
      },
      "required": [
        "type"
      ],
      "title": "Goal",
      "type": "object"
    },
    "ItineraryFields": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "destination": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "departure": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "return_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Date"
        },
        "travellers": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travellers"
        },
        "lead_name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Name"
        },
        "cabin": {
          "anyOf": [
            {
              "enum": [
                "ECONOMY",
                "PREMIUM_ECONOMY",
                "BUSINESS",
                "FIRST"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cabin"
        },
        "seat_preference": {
          "anyOf": [
            {
              "enum": [
                "WINDOW",
                "AISLE",
                "MIDDLE",
                "TOGETHER",
                "ANY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Preference"
        },
        "airline_preference": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Airline Preference"
        }
      },
      "title": "ItineraryFields",
      "type": "object"
    },
    "Keep": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "KEEP_BOOKING",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Keep",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ADJUST_PRICE",
          "title": "Op",
          "type": "string"
        },
        "discount_cents": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Discount Cents",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "discount_cents"
      ],
      "title": "Price",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "REQUEST_AMENDMENT",
            "GUARANTEE_AMENDMENT"
          ],
          "title": "Op",
          "type": "string"
        },
        "days": {
          "maximum": 90,
          "minimum": -90,
          "title": "Days",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "days"
      ],
      "title": "Request",
      "type": "object"
    },
    "ReviseItinerary": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "REVISE_ITINERARY",
            "UPDATE_ITINERARY_DETAILS"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "ReviseItinerary",
      "type": "object"
    },
    "Sequence": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "SEQUENCE",
          "title": "Op",
          "type": "string"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "ADJUST_PRICE": "#/$defs/Price",
                "CONFIRM_AMENDMENT": "#/$defs/Confirm",
                "GUARANTEE_AMENDMENT": "#/$defs/Request",
                "IF": "#/$defs/Conditional",
                "ISSUE_TRIP_CREDIT": "#/$defs/Credit",
                "KEEP_BOOKING": "#/$defs/Keep",
                "REQUEST_AMENDMENT": "#/$defs/Request",
                "REVISE_ITINERARY": "#/$defs/ReviseItinerary",
                "SEQUENCE": "#/$defs/Sequence",
                "UPDATE_ITINERARY_DETAILS": "#/$defs/ReviseItinerary",
                "UPDATE_SEAT_PREFERENCE": "#/$defs/UpdateSeatPreference",
                "UPGRADE": "#/$defs/Upgrade"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Keep"
              },
              {
                "$ref": "#/$defs/Request"
              },
              {
                "$ref": "#/$defs/Confirm"
              },
              {
                "$ref": "#/$defs/Price"
              },
              {
                "$ref": "#/$defs/Credit"
              },
              {
                "$ref": "#/$defs/Upgrade"
              },
              {
                "$ref": "#/$defs/UpdateSeatPreference"
              },
              {
                "$ref": "#/$defs/ReviseItinerary"
              },
              {
                "$ref": "#/$defs/Sequence"
              },
              {
                "$ref": "#/$defs/Conditional"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "op",
        "steps"
      ],
      "title": "Sequence",
      "type": "object"
    },
    "Strategy": {
      "additionalProperties": false,
      "properties": {
        "strategy_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "Strategy Id",
          "type": "string"
        },
        "plan": {
          "discriminator": {
            "mapping": {
              "ADJUST_PRICE": "#/$defs/Price",
              "CONFIRM_AMENDMENT": "#/$defs/Confirm",
              "GUARANTEE_AMENDMENT": "#/$defs/Request",
              "IF": "#/$defs/Conditional",
              "ISSUE_TRIP_CREDIT": "#/$defs/Credit",
              "KEEP_BOOKING": "#/$defs/Keep",
              "REQUEST_AMENDMENT": "#/$defs/Request",
              "REVISE_ITINERARY": "#/$defs/ReviseItinerary",
              "SEQUENCE": "#/$defs/Sequence",
              "UPDATE_ITINERARY_DETAILS": "#/$defs/ReviseItinerary",
              "UPDATE_SEAT_PREFERENCE": "#/$defs/UpdateSeatPreference",
              "UPGRADE": "#/$defs/Upgrade"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Keep"
            },
            {
              "$ref": "#/$defs/Request"
            },
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "$ref": "#/$defs/Price"
            },
            {
              "$ref": "#/$defs/Credit"
            },
            {
              "$ref": "#/$defs/Upgrade"
            },
            {
              "$ref": "#/$defs/UpdateSeatPreference"
            },
            {
              "$ref": "#/$defs/ReviseItinerary"
            },
            {
              "$ref": "#/$defs/Sequence"
            },
            {
              "$ref": "#/$defs/Conditional"
            }
          ],
          "title": "Plan"
        }
      },
      "required": [
        "strategy_id",
        "plan"
      ],
      "title": "Strategy",
      "type": "object"
    },
    "UpdateSeatPreference": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "UPDATE_SEAT_PREFERENCE",
          "title": "Op",
          "type": "string"
        },
        "seat_preference": {
          "enum": [
            "WINDOW",
            "AISLE",
            "MIDDLE",
            "TOGETHER",
            "ANY"
          ],
          "title": "Seat Preference",
          "type": "string"
        }
      },
      "required": [
        "op",
        "seat_preference"
      ],
      "title": "UpdateSeatPreference",
      "type": "object"
    },
    "Upgrade": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "UPGRADE",
          "title": "Op",
          "type": "string"
        },
        "charge_cents": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Charge Cents",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "charge_cents"
      ],
      "title": "Upgrade",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
      "title": "Request Id",
      "type": "string"
    },
    "booking_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
      "title": "Booking Id",
      "type": "string"
    },
    "goal": {
      "$ref": "#/$defs/Goal"
    },
    "needs_clarification": {
      "title": "Needs Clarification",
      "type": "boolean"
    },
    "candidate_strategies": {
      "items": {
        "$ref": "#/$defs/Strategy"
      },
      "maxItems": 5,
      "title": "Candidate Strategies",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "booking_id",
    "goal",
    "needs_clarification",
    "candidate_strategies"
  ],
  "title": "Proposal",
  "type": "object"
}